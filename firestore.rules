rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBranchId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true &&
          request.auth.token.email == 'smokeydhlamini@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasStaffDoc() && staffData().role == 'admin' && staffData().active == true)
      );
    }

    function isMarketing() {
      return isSignedIn()
        && hasStaffDoc()
        && staffData().role == 'marketing'
        && staffData().active == true;
    }

    function isAgentForBranch(branchId) {
      return isSignedIn()
        && isValidBranchId(branchId)
        && hasStaffDoc()
        && staffData().role == 'agent'
        && staffData().active == true
        && staffData().allocatedDealershipId == branchId;
    }

    function isDeptStaffForBranch(roleName, branchId) {
      return isSignedIn()
        && isValidBranchId(branchId)
        && hasStaffDoc()
        && staffData().role == roleName
        && staffData().active == true
        && staffData().allocatedDealershipId == branchId;
    }

    function isValidGroupSettings(data) {
      return data.keys().hasAll([
          'id', 'groupName', 'legalEntity', 'fspNumber', 'complianceOfficer',
          'complianceEmail', 'vwRoadsideTollFree', 'vwRoadsideCrossBorder',
          'testDriveHoursSummary', 'groupLogoSrc', 'emblemLogoSrc', 'youtubeUrl',
          'defaultBranchId', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'groupName', 'legalEntity', 'fspNumber', 'complianceOfficer',
          'complianceEmail', 'vwRoadsideTollFree', 'vwRoadsideCrossBorder',
          'testDriveHoursSummary', 'groupLogoSrc', 'emblemLogoSrc', 'youtubeUrl',
          'defaultBranchId', 'updatedAt', 'updatedBy'
        ])
        && data.id == 'main'
        && data.groupName is string && data.groupName.size() >= 2 && data.groupName.size() <= 120
        && data.legalEntity is string && data.legalEntity.size() >= 2 && data.legalEntity.size() <= 140
        && data.fspNumber is string && data.fspNumber.size() >= 2 && data.fspNumber.size() <= 30
        && data.complianceOfficer is string && data.complianceOfficer.size() >= 2 && data.complianceOfficer.size() <= 120
        && data.complianceEmail is string && data.complianceEmail.size() >= 5 && data.complianceEmail.size() <= 140
        && data.vwRoadsideTollFree is string && data.vwRoadsideTollFree.size() >= 5 && data.vwRoadsideTollFree.size() <= 40
        && data.vwRoadsideCrossBorder is string && data.vwRoadsideCrossBorder.size() >= 5 && data.vwRoadsideCrossBorder.size() <= 40
        && data.testDriveHoursSummary is string && data.testDriveHoursSummary.size() >= 5 && data.testDriveHoursSummary.size() <= 160
        && data.groupLogoSrc is string && data.groupLogoSrc.size() <= 500
        && data.emblemLogoSrc is string && data.emblemLogoSrc.size() <= 500
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 300
        && isValidBranchId(data.defaultBranchId)
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidDealership(data, branchParam) {
      return data.keys().hasAll([
          'id', 'name', 'shortName', 'legalEntity', 'fspNumber', 'domain',
          'receptionNumber', 'whatsappNumber', 'email', 'physicalAddress',
          'postalAddress', 'city', 'province', 'salesHours', 'serviceHours',
          'roadsideAssist', 'vwFinancialServices', 'volkswagensure',
          'mapEmbedUrl', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'shortName', 'referenceCode', 'legalEntity', 'fspNumber', 'domain',
          'receptionNumber', 'whatsappNumber', 'email', 'physicalAddress',
          'postalAddress', 'city', 'province', 'salesHours', 'serviceHours',
          'roadsideAssist', 'vwFinancialServices', 'volkswagensure',
          'mapEmbedUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl',
          'autotraderDealerId', 'autotraderUrl', 'syncEnabled',
          'archived', 'sortOrder', 'updatedAt', 'updatedBy'
        ])
        && isValidBranchId(data.id) && data.id == branchParam
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 120
        && data.shortName is string && data.shortName.size() >= 2 && data.shortName.size() <= 60
        && (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() <= 10))
        && data.legalEntity is string && data.legalEntity.size() >= 2 && data.legalEntity.size() <= 140
        && data.fspNumber is string && data.fspNumber.size() >= 2 && data.fspNumber.size() <= 30
        && data.domain is string && data.domain.size() >= 3 && data.domain.size() <= 120
        && data.receptionNumber is string && data.receptionNumber.size() >= 5 && data.receptionNumber.size() <= 40
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 40
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 140
        && data.physicalAddress is string && data.physicalAddress.size() >= 5 && data.physicalAddress.size() <= 200
        && data.postalAddress is string && data.postalAddress.size() <= 160
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.province is string && data.province.size() >= 2 && data.province.size() <= 80
        && data.salesHours is string && data.salesHours.size() >= 5 && data.salesHours.size() <= 160
        && data.serviceHours is string && data.serviceHours.size() >= 5 && data.serviceHours.size() <= 160
        && data.roadsideAssist is string && data.roadsideAssist.size() >= 5 && data.roadsideAssist.size() <= 40
        && data.vwFinancialServices is string && data.vwFinancialServices.size() >= 5 && data.vwFinancialServices.size() <= 40
        && data.volkswagensure is string && data.volkswagensure.size() >= 5 && data.volkswagensure.size() <= 40
        && data.mapEmbedUrl is string && data.mapEmbedUrl.size() <= 600
        && (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300))
        && (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 300))
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 300))
        && (!('autotraderDealerId' in data) || (data.autotraderDealerId is string && data.autotraderDealerId.size() <= 30))
        && (!('autotraderUrl' in data) || (data.autotraderUrl is string && data.autotraderUrl.size() <= 300 && (data.autotraderUrl == '' || data.autotraderUrl.matches('^https://(www\\.)?autotrader\\.co\\.za/dealer/.*$'))))
        && (!('syncEnabled' in data) || data.syncEnabled is bool)
        && (!('archived' in data) || data.archived is bool)
        && (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000))
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll([
          'id', 'title', 'make', 'model', 'year', 'price', 'monthlyFrom', 'mileage',
          'transmission', 'fuelType', 'category', 'bodyStyle', 'powerKw',
          'fuelEconomy', 'colour', 'images', 'homeDealershipId', 'status',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'make', 'model', 'year', 'price', 'monthlyFrom', 'mileage',
          'transmission', 'fuelType', 'category', 'bodyStyle', 'powerKw',
          'fuelEconomy', 'colour', 'images', 'homeDealershipId', 'status',
          'source', 'externalListingId', 'dealerId', 'variant', 'priceFormatted',
          'canonicalUrl', 'lastSyncedAt', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.make is string && data.make.size() >= 2 && data.make.size() <= 60
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 100
        && data.year is number && data.year >= 1990 && data.year <= 2100
        && data.price is number && data.price >= 0
        && data.monthlyFrom is number && data.monthlyFrom >= 0
        && data.mileage is number && data.mileage >= 0 && data.mileage <= 2000000
        && data.transmission is string && data.transmission.size() >= 2 && data.transmission.size() <= 60
        && data.fuelType is string && data.fuelType.size() >= 2 && data.fuelType.size() <= 40
        && data.category in ['New', 'Used', 'MasterCars']
        && data.bodyStyle in ['Hatchbacks & Sedans', 'SUVs', 'Commercial']
        && data.powerKw is string && data.powerKw.size() >= 2 && data.powerKw.size() <= 40
        && data.fuelEconomy is string && data.fuelEconomy.size() >= 2 && data.fuelEconomy.size() <= 40
        && data.colour is string && data.colour.size() >= 2 && data.colour.size() <= 60
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 10
        && data.images[0] is string && data.images[0].size() >= 5 && data.images[0].size() <= 500
        && isValidBranchId(data.homeDealershipId)
        && data.status in ['available', 'reserved', 'sold']
        && (!('source' in data) || data.source in ['autotrader', 'manual'])
        && (!('externalListingId' in data) || (data.externalListingId is string && data.externalListingId.size() <= 60))
        && (!('dealerId' in data) || (data.dealerId is string && data.dealerId.size() <= 30))
        && (!('variant' in data) || (data.variant is string && data.variant.size() <= 140))
        && (!('priceFormatted' in data) || (data.priceFormatted is string && data.priceFormatted.size() <= 40))
        && (!('canonicalUrl' in data) || (data.canonicalUrl is string && data.canonicalUrl.size() <= 400))
        && (!('lastSyncedAt' in data) || data.lastSyncedAt == null || data.lastSyncedAt == request.time || data.lastSyncedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidPromotion(data) {
      return data.keys().hasAll([
          'id', 'title', 'type', 'description', 'imageUrl', 'validUntil',
          'scope', 'dealershipId', 'active', 'vehicleName', 'offerPrice',
          'monthlyFrom', 'eventTime', 'location', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'type', 'description', 'imageUrl', 'mediaType', 'validUntil',
          'scope', 'dealershipId', 'active', 'vehicleName', 'offerPrice',
          'monthlyFrom', 'eventTime', 'location', 'updatedAt', 'updatedBy'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.type in ['special', 'event', 'competition']
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && data.imageUrl is string && data.imageUrl.size() >= 5 && data.imageUrl.size() <= 500
        && (!('mediaType' in data) || data.mediaType in ['image', 'video'])
        && data.validUntil is string && data.validUntil.size() == 10 && data.validUntil.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.scope in ['MASTER', 'BRANCH']
        && (
          (data.scope == 'MASTER' && data.dealershipId == null) ||
          (data.scope == 'BRANCH' && isValidBranchId(data.dealershipId))
        )
        && data.active is bool
        && data.vehicleName is string && data.vehicleName.size() <= 120
        && data.offerPrice is number && data.offerPrice >= 0
        && data.monthlyFrom is number && data.monthlyFrom >= 0
        && data.eventTime is string && data.eventTime.size() <= 60
        && data.location is string && data.location.size() <= 140
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidNews(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'publishedDate', 'readTime', 'excerpt',
          'bodyText', 'featured', 'archived', 'imageSrc', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'publishedDate', 'readTime', 'excerpt',
          'bodyText', 'featured', 'archived', 'imageSrc', 'updatedAt', 'updatedBy'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 180
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.publishedDate is string && data.publishedDate.size() >= 4 && data.publishedDate.size() <= 60
        && data.readTime is string && data.readTime.size() >= 3 && data.readTime.size() <= 30
        && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 400
        && data.bodyText is string && data.bodyText.size() >= 10 && data.bodyText.size() <= 6000
        && data.featured is bool
        && data.archived is bool
        && data.imageSrc is string && data.imageSrc.size() >= 5 && data.imageSrc.size() <= 500
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidLead(data) {
      return data.keys().hasAll([
          'id', 'leadType', 'fullName', 'phone', 'email', 'subject', 'details',
          'submittedAtDealershipId', 'homeDealershipId', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'leadType', 'fullName', 'phone', 'email', 'subject', 'details',
          'submittedAtDealershipId', 'homeDealershipId', 'status', 'createdAt'
        ])
        && isValidId(data.id)
        && data.leadType in ['test-drive', 'service', 'parts', 'finance', 'vehicle-inquiry', 'contact', 'event-rsvp', 'competition-entry']
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 140
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 200
        && data.details is string && data.details.size() <= 6000
        && isValidBranchId(data.submittedAtDealershipId)
        && (data.homeDealershipId == null || isValidBranchId(data.homeDealershipId))
        && data.status in ['new', 'contacted', 'archived']
        && data.createdAt is timestamp;
    }

    function isValidAdminDoc(data, uidParam) {
      return data.keys().hasAll(['uid', 'email', 'role', 'addedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'addedAt'])
        && isValidId(data.uid) && data.uid == uidParam
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 140
        && data.role == 'admin'
        && data.addedAt == request.time;
    }

    function isValidStaffUser(data, uidParam) {
      return data.keys().hasAll([
          'uid', 'fullName', 'phone', 'email', 'role', 'allocatedDealershipId',
          'mustChangePassword', 'active', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'phone', 'email', 'role', 'allocatedDealershipId',
          'mustChangePassword', 'active', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && isValidId(data.uid) && data.uid == uidParam
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 140
        && data.role in ['admin', 'agent', 'parts', 'marketing', 'service']
        && (
          (data.role in ['admin', 'marketing'] && (data.allocatedDealershipId == null || isValidBranchId(data.allocatedDealershipId))) ||
          (data.role in ['agent', 'parts', 'service'] && isValidBranchId(data.allocatedDealershipId))
        )
        && data.mustChangePassword is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.createdBy is string && data.createdBy.size() >= 2 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    // Connection health check doc (read-only single doc)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Corporate Dealership Group configuration ("main")
    match /groupSettings/{docId} {
      allow get: if docId == 'main';
      allow list: if false;
      allow create, update: if isAdmin() && docId == 'main' && isValidGroupSettings(incoming());
      allow delete: if false;
    }

    // Dynamic Dealership branches (supports 1, 2, 3, 4+ active and archived branches)
    match /dealerships/{branchId} {
      allow get: if isValidBranchId(branchId);
      allow list: if resource.data.archived == false || isAdmin();
      allow create, update: if isAdmin() && isValidBranchId(branchId) && isValidDealership(incoming(), branchId);
      allow delete: if isAdmin() && isValidBranchId(branchId);
    }

    // Master Group Stock shared across dealership sites
    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId) && (existing().status == 'available' || isAdmin() || isAgentForBranch(existing().homeDealershipId));
      allow list: if resource.data.status == 'available' || isAdmin() || isAgentForBranch(resource.data.homeDealershipId);
      allow create: if isValidId(vehicleId)
        && incoming().id == vehicleId
        && incoming().createdAt == request.time
        && isValidVehicle(incoming())
        && (
          isAdmin() ||
          (isAgentForBranch(incoming().homeDealershipId) && (!('source' in incoming()) || incoming().source == 'manual'))
        );
      allow update: if isValidId(vehicleId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && isValidVehicle(incoming())
        && (
          isAdmin() ||
          (isAgentForBranch(existing().homeDealershipId)
            && incoming().homeDealershipId == existing().homeDealershipId
            && (!('source' in incoming()) || incoming().source == 'manual'))
        );
      allow delete: if isValidId(vehicleId)
        && (
          isAdmin() ||
          (isAgentForBranch(existing().homeDealershipId) && (!('source' in existing()) || existing().source == 'manual'))
        );
    }

    // Scoped Specials, Events & Competitions
    match /promotions/{promotionId} {
      allow get: if isValidId(promotionId) && (
        existing().active == true ||
        isAdmin() ||
        isMarketing() ||
        (existing().scope == 'BRANCH' && isAgentForBranch(existing().dealershipId)) ||
        (existing().scope == 'BRANCH' && existing().type == 'special' && (
          isDeptStaffForBranch('parts', existing().dealershipId) ||
          isDeptStaffForBranch('service', existing().dealershipId)
        ))
      );
      allow list: if
        resource.data.active == true ||
        isAdmin() ||
        isMarketing() ||
        (resource.data.scope == 'BRANCH' && isAgentForBranch(resource.data.dealershipId)) ||
        (resource.data.scope == 'BRANCH' && resource.data.type == 'special' && (
          isDeptStaffForBranch('parts', resource.data.dealershipId) ||
          isDeptStaffForBranch('service', resource.data.dealershipId)
        ));
      allow create: if isValidId(promotionId)
        && incoming().id == promotionId
        && isValidPromotion(incoming())
        && (
          isAdmin() ||
          isMarketing() ||
          (incoming().scope == 'BRANCH' && incoming().type in ['special', 'event'] && isAgentForBranch(incoming().dealershipId)) ||
          (incoming().scope == 'BRANCH' && incoming().type == 'special' && (
            isDeptStaffForBranch('parts', incoming().dealershipId) ||
            isDeptStaffForBranch('service', incoming().dealershipId)
          ))
        );
      allow update: if isValidId(promotionId)
        && incoming().id == existing().id
        && isValidPromotion(incoming())
        && (
          isAdmin() ||
          isMarketing() ||
          (existing().scope == 'BRANCH'
            && incoming().scope == 'BRANCH'
            && existing().type in ['special', 'event']
            && incoming().type in ['special', 'event']
            && isAgentForBranch(existing().dealershipId)
            && incoming().dealershipId == existing().dealershipId) ||
          (existing().scope == 'BRANCH'
            && incoming().scope == 'BRANCH'
            && existing().type == 'special'
            && incoming().type == 'special'
            && incoming().dealershipId == existing().dealershipId
            && (
              isDeptStaffForBranch('parts', existing().dealershipId) ||
              isDeptStaffForBranch('service', existing().dealershipId)
            ))
        );
      allow delete: if isValidId(promotionId)
        && (
          isAdmin() ||
          isMarketing() ||
          (existing().scope == 'BRANCH' && existing().type in ['special', 'event'] && isAgentForBranch(existing().dealershipId)) ||
          (existing().scope == 'BRANCH' && existing().type == 'special' && (
            isDeptStaffForBranch('parts', existing().dealershipId) ||
            isDeptStaffForBranch('service', existing().dealershipId)
          ))
        );
    }

    // Motoring News (Admin + Marketing manage group-wide)
    match /news/{articleId} {
      allow get: if isValidId(articleId) && (existing().archived == false || isAdmin() || isMarketing());
      allow list: if resource.data.archived == false || isAdmin() || isMarketing();
      allow create: if (isAdmin() || isMarketing()) && isValidId(articleId) && incoming().id == articleId && isValidNews(incoming());
      allow update: if (isAdmin() || isMarketing()) && isValidId(articleId) && incoming().id == existing().id && isValidNews(incoming());
      allow delete: if (isAdmin() || isMarketing()) && isValidId(articleId);
    }

    // Customer enquiries/bookings (PII protected; Admin full access; Parts & Service clerks branch + department scoped)
    match /leads/{leadId} {
      allow get: if isValidId(leadId) && (
        isAdmin() ||
        (existing().leadType == 'parts' && (
          isDeptStaffForBranch('parts', existing().submittedAtDealershipId) ||
          isDeptStaffForBranch('parts', existing().homeDealershipId)
        )) ||
        (existing().leadType == 'service' && (
          isDeptStaffForBranch('service', existing().submittedAtDealershipId) ||
          isDeptStaffForBranch('service', existing().homeDealershipId)
        ))
      );
      allow list: if
        isAdmin() ||
        (resource.data.leadType == 'parts' && (
          isDeptStaffForBranch('parts', resource.data.submittedAtDealershipId) ||
          isDeptStaffForBranch('parts', resource.data.homeDealershipId)
        )) ||
        (resource.data.leadType == 'service' && (
          isDeptStaffForBranch('service', resource.data.submittedAtDealershipId) ||
          isDeptStaffForBranch('service', resource.data.homeDealershipId)
        ));
      allow create: if isValidId(leadId)
        && incoming().id == leadId
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && isValidLead(incoming());
      allow update: if isValidId(leadId)
        && isValidLead(incoming())
        && incoming().id == existing().id
        && incoming().leadType == existing().leadType
        && incoming().submittedAtDealershipId == existing().submittedAtDealershipId
        && incoming().homeDealershipId == existing().homeDealershipId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && (
          isAdmin() ||
          (existing().leadType == 'parts' && (
            isDeptStaffForBranch('parts', existing().submittedAtDealershipId) ||
            isDeptStaffForBranch('parts', existing().homeDealershipId)
          )) ||
          (existing().leadType == 'service' && (
            isDeptStaffForBranch('service', existing().submittedAtDealershipId) ||
            isDeptStaffForBranch('service', existing().homeDealershipId)
          ))
        );
      allow delete: if isAdmin() && isValidId(leadId);
    }

    // Dealership admin roster
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(uid) && isValidAdminDoc(incoming(), uid);
      allow delete: if isAdmin() && isValidId(uid);
    }

    // Dealership multi-role staff roster (Admin, Agent, Marketing, Parts, Service)
    match /staffUsers/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(uid)
        && incoming().createdAt == request.time
        && incoming().createdBy == request.auth.uid
        && isValidStaffUser(incoming(), uid);
      allow update: if isSignedIn()
        && isValidId(uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && isValidStaffUser(incoming(), uid)
        && (
          isAdmin() ||
          (
            request.auth.uid == uid
            && existing().active == true
            && existing().mustChangePassword == true
            && incoming().mustChangePassword == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt', 'updatedBy'])
          )
        );
      allow delete: if isAdmin() && isValidId(uid);
    }
  }
}
