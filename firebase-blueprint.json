{
  "entities": {
    "DealershipGroup": {
      "title": "DealershipGroup",
      "description": "Corporate group identity, FSP/POPIA compliance settings, roadside numbers, and default landing branch for the Volkswagen dealership group.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["main"] },
        "groupName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "legalEntity": { "type": "string", "minLength": 2, "maxLength": 140 },
        "fspNumber": { "type": "string", "minLength": 2, "maxLength": 30 },
        "complianceOfficer": { "type": "string", "minLength": 2, "maxLength": 120 },
        "complianceEmail": { "type": "string", "minLength": 5, "maxLength": 140 },
        "vwRoadsideTollFree": { "type": "string", "minLength": 5, "maxLength": 40 },
        "vwRoadsideCrossBorder": { "type": "string", "minLength": 5, "maxLength": 40 },
        "testDriveHoursSummary": { "type": "string", "minLength": 5, "maxLength": 160 },
        "groupLogoSrc": { "type": "string", "maxLength": 500 },
        "emblemLogoSrc": { "type": "string", "maxLength": 500 },
        "youtubeUrl": { "type": "string", "maxLength": 300 },
        "defaultBranchId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "defaultNotifyEmail": { "type": "string", "maxLength": 140 },
        "primarySiteUrl": { "type": "string", "maxLength": 300 },
        "smtpHost": { "type": "string", "maxLength": 140 },
        "smtpPort": { "type": "number" },
        "smtpUser": { "type": "string", "maxLength": 140 },
        "smtpFrom": { "type": "string", "maxLength": 180 },
        "smtpPassEnvKey": { "type": "string", "maxLength": 60, "pattern": "^SMTP_PASS(?:_[A-Z0-9_]{1,40})?$" },
        "licenceScannerEnabled": { "type": "boolean" },
        "autotraderSyncDefault": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "groupName",
        "legalEntity",
        "fspNumber",
        "complianceOfficer",
        "complianceEmail",
        "vwRoadsideTollFree",
        "vwRoadsideCrossBorder",
        "testDriveHoursSummary",
        "groupLogoSrc",
        "emblemLogoSrc",
        "youtubeUrl",
        "defaultBranchId",
        "updatedAt",
        "updatedBy"
      ]
    },
    "Dealership": {
      "title": "Dealership",
      "description": "Dynamic Volkswagen dealership branch configuration supporting 1, 2, 3, 4, or more active and archived branches.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 120 },
        "shortName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "referenceCode": { "type": "string", "maxLength": 10 },
        "legalEntity": { "type": "string", "minLength": 2, "maxLength": 140 },
        "fspNumber": { "type": "string", "minLength": 2, "maxLength": 30 },
        "domain": { "type": "string", "minLength": 3, "maxLength": 120 },
        "receptionNumber": { "type": "string", "minLength": 5, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "minLength": 5, "maxLength": 140 },
        "physicalAddress": { "type": "string", "minLength": 5, "maxLength": 200 },
        "postalAddress": { "type": "string", "maxLength": 160 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "province": { "type": "string", "minLength": 2, "maxLength": 80 },
        "salesHours": { "type": "string", "minLength": 5, "maxLength": 160 },
        "serviceHours": { "type": "string", "minLength": 5, "maxLength": 160 },
        "roadsideAssist": { "type": "string", "minLength": 5, "maxLength": 40 },
        "vwFinancialServices": { "type": "string", "minLength": 5, "maxLength": 40 },
        "volkswagensure": { "type": "string", "minLength": 5, "maxLength": 40 },
        "mapEmbedUrl": { "type": "string", "maxLength": 600 },
        "facebookUrl": { "type": "string", "maxLength": 300 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "youtubeUrl": { "type": "string", "maxLength": 300 },
        "autotraderDealerId": { "type": "string", "maxLength": 30 },
        "autotraderUrl": { "type": "string", "maxLength": 300 },
        "syncEnabled": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "salesNotifyEmail": { "type": "string", "maxLength": 140 },
        "serviceNotifyEmail": { "type": "string", "maxLength": 140 },
        "partsNotifyEmail": { "type": "string", "maxLength": 140 },
        "financeNotifyEmail": { "type": "string", "maxLength": 140 },
        "generalNotifyEmail": { "type": "string", "maxLength": 140 },
        "smtpHost": { "type": "string", "maxLength": 140 },
        "smtpPort": { "type": "number" },
        "smtpUser": { "type": "string", "maxLength": 140 },
        "smtpFrom": { "type": "string", "maxLength": 180 },
        "defaultNotifyEmail": { "type": "string", "maxLength": 140 },
        "smtpPassEnvKey": { "type": "string", "maxLength": 60, "pattern": "^SMTP_PASS(?:_[A-Z0-9_]{1,40})?$" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "name",
        "shortName",
        "legalEntity",
        "fspNumber",
        "domain",
        "receptionNumber",
        "whatsappNumber",
        "email",
        "physicalAddress",
        "postalAddress",
        "city",
        "province",
        "salesHours",
        "serviceHours",
        "roadsideAssist",
        "vwFinancialServices",
        "volkswagensure",
        "mapEmbedUrl",
        "updatedAt",
        "updatedBy"
      ]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Master Group Stock vehicle shared across active branches with homeDealershipId physical location.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "make": { "type": "string", "minLength": 2, "maxLength": 60 },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "year": { "type": "number" },
        "price": { "type": "number" },
        "monthlyFrom": { "type": "number" },
        "mileage": { "type": "number" },
        "transmission": { "type": "string", "minLength": 2, "maxLength": 60 },
        "fuelType": { "type": "string", "minLength": 2, "maxLength": 40 },
        "category": { "type": "string", "enum": ["New", "Demo", "MasterCars", "Used"] },
        "bodyStyle": { "type": "string", "enum": ["Hatchbacks & Sedans", "SUVs", "Commercial"] },
        "powerKw": { "type": "string", "minLength": 2, "maxLength": 40 },
        "fuelEconomy": { "type": "string", "minLength": 2, "maxLength": 40 },
        "colour": { "type": "string", "minLength": 2, "maxLength": 60 },
        "images": { "type": "array" },
        "homeDealershipId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "status": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "source": { "type": "string", "enum": ["autotrader", "manual"] },
        "externalListingId": { "type": "string", "maxLength": 60 },
        "dealerId": { "type": "string", "maxLength": 30 },
        "variant": { "type": "string", "maxLength": 140 },
        "priceFormatted": { "type": "string", "maxLength": 40 },
        "canonicalUrl": { "type": "string", "maxLength": 400 },
        "lastSyncedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "title",
        "make",
        "model",
        "year",
        "price",
        "monthlyFrom",
        "mileage",
        "transmission",
        "fuelType",
        "category",
        "bodyStyle",
        "powerKw",
        "fuelEconomy",
        "colour",
        "images",
        "homeDealershipId",
        "status",
        "createdAt",
        "updatedAt",
        "updatedBy"
      ]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Specials, Events & Competitions scoped to MASTER (group-wide) or a specific BRANCH.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "type": { "type": "string", "enum": ["special", "event", "competition"] },
        "description": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "imageUrl": { "type": "string", "minLength": 5, "maxLength": 500 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "validUntil": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "scope": { "type": "string", "enum": ["MASTER", "BRANCH"] },
        "dealershipId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "active": { "type": "boolean" },
        "vehicleName": { "type": "string", "maxLength": 120 },
        "offerPrice": { "type": "number" },
        "monthlyFrom": { "type": "number" },
        "eventTime": { "type": "string", "maxLength": 60 },
        "location": { "type": "string", "maxLength": 140 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "title",
        "type",
        "description",
        "imageUrl",
        "validUntil",
        "scope",
        "dealershipId",
        "active",
        "vehicleName",
        "offerPrice",
        "monthlyFrom",
        "eventTime",
        "location",
        "updatedAt",
        "updatedBy"
      ]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Motoring news articles published by dealership group administrators or marketing staff.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "minLength": 5, "maxLength": 180 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "publishedDate": { "type": "string", "minLength": 4, "maxLength": 60 },
        "readTime": { "type": "string", "minLength": 3, "maxLength": 30 },
        "excerpt": { "type": "string", "minLength": 10, "maxLength": 400 },
        "bodyText": { "type": "string", "minLength": 10, "maxLength": 6000 },
        "featured": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "imageSrc": { "type": "string", "minLength": 5, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "title",
        "category",
        "publishedDate",
        "readTime",
        "excerpt",
        "bodyText",
        "featured",
        "archived",
        "imageSrc",
        "updatedAt",
        "updatedBy"
      ]
    },
    "LeadSubmission": {
      "title": "LeadSubmission",
      "description": "PII-protected customer test-drive, service, parts, finance, enquiry, competition, or event RSVP submission tagged with originating branch and optional home branch.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "leadType": {
          "type": "string",
          "enum": ["test-drive", "service", "parts", "spotter", "finance", "vehicle-inquiry", "contact", "event-rsvp", "competition-entry"]
        },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "email": { "type": "string", "minLength": 5, "maxLength": 140 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 6000 },
        "submittedAtDealershipId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "homeDealershipId": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "leadType",
        "fullName",
        "phone",
        "email",
        "subject",
        "details",
        "submittedAtDealershipId",
        "homeDealershipId",
        "status",
        "createdAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized dealership group administrator roster.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "email": { "type": "string", "minLength": 5, "maxLength": 140 },
        "role": { "type": "string", "enum": ["admin"] },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "addedAt"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Dealership staff user profile covering Administrator, Car Sales Agent, Marketing, Parts Sales Executive, and Service Booking Clerk.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "email": { "type": "string", "minLength": 5, "maxLength": 140 },
        "role": { "type": "string", "enum": ["admin", "branch_admin", "it_manager", "it_agent", "agent", "parts", "marketing", "service"] },
        "allocatedDealershipId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "mustChangePassword": { "type": "boolean" },
        "active": { "type": "boolean" },
        "activeEscalation": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "uid",
        "fullName",
        "phone",
        "email",
        "role",
        "allocatedDealershipId",
        "mustChangePassword",
        "active",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy"
      ]
    },
    "ItEscalationTicket": {
      "title": "ItEscalationTicket",
      "description": "IT Agent role-escalation and technical support ticket reviewed by the Group IT Manager or Group Administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "requesterUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "requesterName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "requesterEmail": { "type": "string", "minLength": 5, "maxLength": 140 },
        "requesterBranchId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "targetDealershipId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "requestedRole": { "type": "string", "enum": ["branch_admin", "agent", "parts", "service", "marketing"] },
        "requestedDurationMinutes": { "type": "number" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "approved_temporary", "resolved", "rejected", "revoked"] },
        "reviewNote": { "type": "string", "maxLength": 1000 },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 120 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "requesterUid",
        "requesterName",
        "requesterEmail",
        "requesterBranchId",
        "targetDealershipId",
        "requestedRole",
        "requestedDurationMinutes",
        "title",
        "reason",
        "status",
        "reviewNote",
        "reviewedByUid",
        "reviewedByName",
        "approvedAt",
        "expiresAt",
        "resolvedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "JobOpening": {
      "title": "JobOpening",
      "description": "Career job opening listed by the dealership group supporting internal on-site applications or external application portal links.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "department": { "type": "string", "minLength": 2, "maxLength": 80 },
        "dealershipId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "locationLabel": { "type": "string", "minLength": 2, "maxLength": 140 },
        "employmentType": { "type": "string", "enum": ["Full-Time", "Part-Time", "Apprenticeship", "Fixed-Term"] },
        "closingDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 600 },
        "responsibilities": { "type": "string", "maxLength": 4000 },
        "requirements": { "type": "string", "minLength": 5, "maxLength": 4000 },
        "applicationMode": { "type": "string", "enum": ["internal", "external"] },
        "externalApplyUrl": { "type": "string", "maxLength": 500 },
        "requiresLicence": { "type": "boolean" },
        "licenceDescription": { "type": "string", "maxLength": 200 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "required": [
        "id",
        "title",
        "department",
        "dealershipId",
        "locationLabel",
        "employmentType",
        "closingDate",
        "summary",
        "responsibilities",
        "requirements",
        "applicationMode",
        "externalApplyUrl",
        "requiresLicence",
        "licenceDescription",
        "active",
        "updatedAt",
        "updatedBy"
      ]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "PII-protected on-site career application with references to private uploaded documents (Resume, Qualifications, ID Copy, and optional Licence).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "jobId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "jobTitle": { "type": "string", "minLength": 3, "maxLength": 160 },
        "branchId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 5, "maxLength": 140 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "idNumber": { "type": "string", "minLength": 5, "maxLength": 40 },
        "cityOrSuburb": { "type": "string", "minLength": 2, "maxLength": 120 },
        "yearsExperience": { "type": "number" },
        "highestQualification": { "type": "string", "minLength": 2, "maxLength": 140 },
        "driversLicenceCode": { "type": "string", "maxLength": 80 },
        "coverNote": { "type": "string", "maxLength": 4000 },
        "resumeDoc": { "type": "object" },
        "qualificationDoc": { "type": "object" },
        "idCopyDoc": { "type": "object" },
        "licenceDoc": { "type": "object" },
        "status": { "type": "string", "enum": ["new", "shortlisted", "interview", "rejected", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "jobId",
        "jobTitle",
        "branchId",
        "fullName",
        "email",
        "phone",
        "idNumber",
        "cityOrSuburb",
        "yearsExperience",
        "highestQualification",
        "driversLicenceCode",
        "coverNote",
        "resumeDoc",
        "qualificationDoc",
        "idCopyDoc",
        "licenceDoc",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/groupSettings/{docId}": {
      "schema": { "$ref": "#/entities/DealershipGroup" },
      "description": "Corporate group settings document ('main') defining group identity, FSP/compliance info, and default landing branch."
    },
    "/dealerships/{branchId}": {
      "schema": { "$ref": "#/entities/Dealership" },
      "description": "Dynamic dealership branch metadata and contact settings (supports any number of active or archived branches)."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Shared Master Group Stock displayed across active dealership websites."
    },
    "/promotions/{promotionId}": {
      "schema": { "$ref": "#/entities/Promotion" },
      "description": "Specials, Events, and Competitions scoped globally (MASTER) or to a specific branch."
    },
    "/news/{articleId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "Motoring news articles."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/LeadSubmission" },
      "description": "PII-protected customer callback and booking submissions tagged with branch IDs."
    },
    "/careersJobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobOpening" },
      "description": "Dealership career opportunities supporting on-site applications or external application links."
    },
    "/jobApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "PII-protected on-site job applications and private document attachment metadata (admin read only)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized dealership administrators."
    },
    "/staffUsers/{uid}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Multi-role staff roster with role-based permissions, branch allocation, and IT-approved temporary escalation state."
    },
    "/itTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/ItEscalationTicket" },
      "description": "IT Agent role-escalation and technical support ticket queue managed by IT Managers and Group Administrators."
    }
  }
}
