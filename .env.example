# PORT: TCP port on which Express (server.ts) listens in development and production.
PORT="3000"

# APP_URL: Public base URL where your dealership website is hosted (no trailing slash).
# Example locally: http://localhost:3000
# Example in production: https://www.yourdealership.co.za
APP_URL="http://localhost:3000"

# DECODO_API_KEY: Optional server-side Decodo Web Data API key for automated AutoTrader dealer scraping.
# Leave blank if adding vehicles manually or importing stock via Paste AutoTrader JSON / HTML in /admin.
# SECURITY: Never prefix this variable with VITE_ and never commit a real .env file to Git.
DECODO_API_KEY=""

# Nodemailer SMTP Email Notifications (server-side only; never prefix with VITE_)
# Leave SMTP_USER / DEFAULT_LEAD_NOTIFY_EMAIL blank to inherit BOOTSTRAPPED_ADMIN_EMAIL from server.ts,
# or override them for your own Gmail / Google Workspace / Microsoft 365 / corporate SMTP relay.
# For Gmail, enable 2-Step Verification and generate a 16-character Google App Password for SMTP_PASS.
# When a branch configures its own sender mailbox (e.g. web@ladysmithvolkswagen.co.za), add its
# branch-specific secret variable shown in /admin (e.g. SMTP_PASS_BRANCH_LADYSMITH="...") alongside SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=
SMTP_FROM=
DEFAULT_LEAD_NOTIFY_EMAIL=""
