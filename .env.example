# ==============================================================================
# Multi-Branch Volkswagen Dealership Platform — Server Environment Template
# ==============================================================================
# Copy this file to `.env` for local/self-hosted servers, or copy each variable
# into Vercel -> Project -> Settings -> Environment Variables (or AI Studio Secrets).
#
# SECURITY RULES:
# 1. NEVER prefix secret variables (GEMINI_API_KEY, DECODO_API_KEY, SMTP_PASS*) with VITE_.
# 2. NEVER commit a real `.env` file containing passwords or API keys to Git.
# 3. Also replace `/firebase-applet-config.json` & `BOOTSTRAPPED_ADMIN_EMAIL` before handover.
# ==============================================================================

# 1. Server Port & Public Application URL
#    - Local example:   http://localhost:3000
#    - Vercel example:  https://your-dealership.vercel.app
#    - Domain example:  https://www.newcastlevw.co.za
PORT="3000"
APP_URL="http://localhost:3000"

# 2. Google Gemini API Key (REQUIRED for Service & Parts Licence Disc OCR Scanner)
#    - How to acquire: https://aistudio.google.com/apikey -> Create API key
#    - Looks like: ~39 characters starting with "AIzaSy" (e.g. AIzaSyD4xK9pQ2wR7mN8vB3cF6hJ1lM0nP5tY)
GEMINI_API_KEY=

# 3. Decodo Web Data API Key (OPTIONAL — automated AutoTrader dealer scraping)
#    - How to acquire: https://dashboard.decodo.com -> Scraping API -> API Keys / Credentials
#    - Looks like: "Basic dXNlcjpwYXNz..." or "username:password"
#    - Leave blank if staff add stock manually or use "Paste AutoTrader JSON / HTML" in /admin.
DECODO_API_KEY=

# 4. Group Default Outgoing Email Server (Nodemailer SMTP)
#    - Gmail / Google Workspace: host="smtp.gmail.com", port="465", 16-char App Password (e.g. abcd efgh ijkl mnop)
#    - Custom Domain / cPanel:   host="mail.yourbranch.co.za", port="465", mailbox password
#    - Microsoft 365:            host="smtp.office365.com", port="587", Authenticated SMTP enabled
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEFAULT_LEAD_NOTIFY_EMAIL=

# 5. Optional Per-Branch SMTP Password Overrides
#    - When a branch uses its own dedicated sender mailbox (e.g. web@ladysmithvolkswagen.co.za),
#      add the branch secret key shown inside /admin -> Group & Branches (never commit real values):
# SMTP_PASS_BRANCH_LADYSMITH=
